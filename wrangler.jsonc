// Cloudflare Workers med statiska filer. Används när projektet skapats som
// "Worker" i Cloudflare (deploy-kommandot är då `npx wrangler deploy`).
// "name" måste vara samma som Workerns namn i Cloudflare-panelen.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "desktopcam",
  "compatibility_date": "2026-11-01",
  // Bara /api/* (felrapporter) går till koden i worker/index.js – allt annat
  // serveras direkt som statiska filer, som tidigare.
  "main": "worker/index.js",
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Felrapporterna skrivs till Workers Logs. Uppgifter om själva anropen
  // (t.ex. IP-adress) sparas inte – bara rapportens egna fält.
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  }
}
