// Cloudflare Workers med statiska filer. Används när projektet skapats som
// "Worker" i Cloudflare (deploy-kommandot är då `npx wrangler deploy`).
// "name" måste vara samma som Workerns namn i Cloudflare-panelen.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "desktopcam",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./apps/dist",
    "not_found_handling": "single-page-application"
  }
}
