{
  "name": "desktopcam",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.40.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @desktopcam/web dev",
    "build": "pnpm test && pnpm --filter @desktopcam/web build",
    "preview": "pnpm --filter @desktopcam/web preview",
    "typecheck": "pnpm -r typecheck",
    "wasm:build": "wasm-pack build crates/cam-engine --release --target web --out-dir ../../apps/web/public/wasm --out-name cam_engine --no-pack",
    "wasm:test": "cargo test --manifest-path crates/cam-engine/Cargo.toml",
    "license:audit": "node scripts/license-audit.mjs",
    "license:check": "node scripts/license-audit.mjs --check",
    "test": "pnpm --filter @desktopcam/web test",
    "test:update": "pnpm --filter @desktopcam/web test:update",
    "test:e2e": "pnpm --filter @desktopcam/web test:e2e"
  }
}
