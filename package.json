{
  "name": "desktopcam",
  "private": true,
  "version": "0.23.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @desktopcam/web dev",
    "build": "pnpm --filter @desktopcam/web build",
    "preview": "pnpm --filter @desktopcam/web preview",
    "typecheck": "pnpm -r typecheck",
    "wasm:build": "wasm-pack build crates/cam-engine --release --target web --out-dir ../../apps/web/public/wasm --out-name cam_engine --no-pack",
    "wasm:test": "cargo test --manifest-path crates/cam-engine/Cargo.toml"
  }
}
